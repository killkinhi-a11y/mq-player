# =============================================
# MQ Player — Environment Variables
# =============================================

# Database (Vercel Postgres — free, built into Vercel)
DATABASE_URL="postgres://default:xxx@xxx-postgres.render-1.com.vercel-storage.com/verceldb?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://default:xxx@xxx-postgres.render-1.com.vercel-storage.com/verceldb?sslmode=require"

# ── Turso (libSQL/SQLite edge database) — PRIMARY for Vercel serverless ──────
# When TURSO_DATABASE_URL is set, the app uses Turso instead of Prisma/PostgreSQL.
# This is required for Vercel deployment (SQLite file:// doesn't work on serverless).
#
# Sign up at https://turso.tech — free tier: 500MB, 1B row reads
# 1. Install CLI: curl -sSfL https://get.tur.so/install.sh | bash
# 2. Create database: turso db create mq-player
# 3. Get URL: turso db show mq-player --url
# 4. Get auth token: turso db tokens create mq-player
#
# For Vercel deployment, set these in Vercel Dashboard → Settings → Environment Variables
# Or use: vercel env add TURSO_DATABASE_URL / vercel env add TURSO_AUTH_TOKEN
TURSO_DATABASE_URL="libsql://mq-player-xxx.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOiJF..."
#
# For local development (no auth needed):
# TURSO_DATABASE_URL="file:./dev.db"
# (Leave TURSO_DATABASE_URL empty to use Prisma/PostgreSQL locally)
#
# Migration: npx tsx scripts/migrate-to-turso.ts --dry-run   (preview)
#            npx tsx scripts/migrate-to-turso.ts             (run)

# Upload directory (Vercel only supports /tmp)
UPLOADS_DIR="/tmp/uploads"

# ── Brevo (Sendinblue) — Email delivery (FREE, 300/day, no domain needed) ──
# 1. Sign up at https://www.brevo.com
# 2. Settings → SMTP & API → Generate a new API key → paste below:
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxx"
# 3. Settings → Senders → Add a sender → verify via email → paste below:
BREVO_SENDER_EMAIL="your-verified@email.com"
# 4. (Optional) Custom sender name:
BREVO_SENDER_NAME="MQ Player"

# Admin emails (comma-separated, for admin panel access)
NEXT_PUBLIC_ADMIN_EMAILS="killkin.hi@gmail.com"

# JWT Secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET="CHANGE_ME_to_a_random_32_char_string"

# ── Telegram Bot (for Telegram-based auth) ──
# 1. Create a bot via @BotFather on Telegram
# 2. Get the bot token and paste below:
TELEGRAM_BOT_TOKEN=""
# 3. (Optional) Bot username for display in UI:
TELEGRAM_BOT_NAME=""
# 4. Webhook secret token (set when configuring webhook — prevents forged requests)
#    Generate with: openssl rand -hex 32
#    When setting webhook: https://api.telegram.org/bot<TOKEN>/setWebhook?url=<YOUR_URL>/api/telegram/webhook&secret_token=<THIS_VALUE>
TELEGRAM_WEBHOOK_SECRET=""

# ── AI Proxy ──
# Cloudflare tunnel URL for ZAI API (optional — if not set, AI features use direct SDK)
ZAI_TUNNEL_URL=""

# ── Spotify API (search, full playback via Web Playback SDK) ──
# 1. Go to https://developer.spotify.com/dashboard
# 2. Create an app → get Client ID and Client Secret
# 3. Set Redirect URI: https://your-domain.com/api/spotify/auth/callback
# 4. Paste below:
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Base URL (needed for Spotify OAuth callback redirect)
# On Vercel this is set automatically; for local dev use http://localhost:3000
NEXT_PUBLIC_BASE_URL=""

# ── Sentry — Error tracking & performance monitoring ──
# 1. Sign up at https://sentry.io
# 2. Create a new Next.js project → get the DSN
# 3. Paste the DSN below (starts with https://...)
# If not set, Sentry will be initialized but won't send any events (graceful no-op).
NEXT_PUBLIC_SENTRY_DSN=""
# Organization slug (from Sentry → Settings → Organization)
SENTRY_ORG=""
# Project slug (from Sentry → Project Settings)
SENTRY_PROJECT=""
