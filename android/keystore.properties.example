# ─────────────────────────────────────────────────────────────────────────────
# RELEASE SIGNING — copy to `keystore.properties` and fill in YOUR values.
#
#   cp keystore.properties.example keystore.properties
#
# `keystore.properties`, `*.jks`, `*.keystore`, `*.p12`, `*.pem`, `*.key`
# are ALL gitignored — signing material is NEVER committed.
#
# Create a keystore (30-year self-signed key, standard for sideloaded apps):
#
#   keytool -genkeypair -v \
#     -keystore /absolute/path/to/mq-release.jks \
#     -alias mq-release \
#     -keyalg RSA -keysize 2048 -validity 10950 \
#     -storetype PKCS12 \
#     -storepass <YOUR_STRONG_PASSWORD> \
#     -dname "CN=MQ Player Android, OU=Mobile, O=MQ, C=RU"
#
# Without this file `./gradlew assembleRelease` produces an UNSIGNED APK.
# With it, release APK + AAB are signed automatically.
#
# After the first signing, add the certificate SHA-256 fingerprint to
# public/.well-known/assetlinks.json (App Links verification):
#
#   keytool -list -v -keystore mq-release.jks -storepass <pass> | grep SHA256
# ─────────────────────────────────────────────────────────────────────────────
# Path to the keystore file (absolute path is safest):
storeFile=/absolute/path/to/mq-release.jks

# Keystore password (keep private; PKCS12 uses one password for store+key):
storePassword=CHANGE_ME

# Key alias inside the keystore:
keyAlias=mq-release

# Key password (same as storePassword for PKCS12):
keyPassword=CHANGE_ME
