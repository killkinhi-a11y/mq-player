{
  "contract": "queue-rules",
  "contractVersion": 1,
  "cases": [
    {
      "id": "next-middle",
      "description": "Next in the middle of the queue",
      "fn": "nextIndex",
      "input": {
        "length": 5,
        "index": 1,
        "repeat": "off",
        "broken": []
      },
      "expected": 2
    },
    {
      "id": "next-end-repeat-off",
      "description": "Next at the end with repeat off \u2192 no next",
      "fn": "nextIndex",
      "input": {
        "length": 3,
        "index": 2,
        "repeat": "off",
        "broken": []
      },
      "expected": null
    },
    {
      "id": "next-end-repeat-all",
      "description": "Next at the end with repeat all wraps",
      "fn": "nextIndex",
      "input": {
        "length": 3,
        "index": 2,
        "repeat": "all",
        "broken": []
      },
      "expected": 0
    },
    {
      "id": "next-end-repeat-one",
      "description": "Manual Next with repeat one behaves like off at the end",
      "fn": "nextIndex",
      "input": {
        "length": 3,
        "index": 2,
        "repeat": "one",
        "broken": []
      },
      "expected": null
    },
    {
      "id": "next-repeat-one-middle",
      "description": "Manual Next with repeat one still advances",
      "fn": "nextIndex",
      "input": {
        "length": 3,
        "index": 0,
        "repeat": "one",
        "broken": []
      },
      "expected": 1
    },
    {
      "id": "next-skip-broken",
      "description": "Broken items are skipped",
      "fn": "nextIndex",
      "input": {
        "length": 5,
        "index": 0,
        "repeat": "off",
        "broken": [
          1,
          2
        ]
      },
      "expected": 3
    },
    {
      "id": "next-skip-broken-no-wrap",
      "description": "Broken skip never wraps with repeat off (web bug: wrapped to 0)",
      "fn": "nextIndex",
      "input": {
        "length": 4,
        "index": 1,
        "repeat": "off",
        "broken": [
          2,
          3
        ]
      },
      "expected": null
    },
    {
      "id": "next-skip-broken-wrap-all",
      "description": "Broken skip wraps with repeat all",
      "fn": "nextIndex",
      "input": {
        "length": 4,
        "index": 1,
        "repeat": "all",
        "broken": [
          2,
          3
        ]
      },
      "expected": 0
    },
    {
      "id": "next-all-broken",
      "description": "Everything else broken \u2192 no next (never replays current)",
      "fn": "nextIndex",
      "input": {
        "length": 3,
        "index": 1,
        "repeat": "all",
        "broken": [
          0,
          2
        ]
      },
      "expected": null
    },
    {
      "id": "next-empty",
      "description": "Empty queue \u2192 no next",
      "fn": "nextIndex",
      "input": {
        "length": 0,
        "index": 0,
        "repeat": "all",
        "broken": []
      },
      "expected": null
    },
    {
      "id": "ended-repeat-one",
      "description": "Track ended with repeat one \u2192 same index",
      "fn": "autoAdvanceIndex",
      "input": {
        "length": 3,
        "index": 1,
        "repeat": "one",
        "broken": []
      },
      "expected": 1
    },
    {
      "id": "ended-repeat-off-end",
      "description": "Track ended at the end with repeat off \u2192 stop",
      "fn": "autoAdvanceIndex",
      "input": {
        "length": 3,
        "index": 2,
        "repeat": "off",
        "broken": []
      },
      "expected": null
    },
    {
      "id": "ended-repeat-all-end",
      "description": "Track ended at the end with repeat all \u2192 0",
      "fn": "autoAdvanceIndex",
      "input": {
        "length": 3,
        "index": 2,
        "repeat": "all",
        "broken": []
      },
      "expected": 0
    },
    {
      "id": "ended-repeat-one-broken",
      "description": "Repeat one on a broken track moves on (no infinite retry)",
      "fn": "autoAdvanceIndex",
      "input": {
        "length": 3,
        "index": 1,
        "repeat": "one",
        "broken": [
          1
        ]
      },
      "expected": 2
    },
    {
      "id": "prev-restart-after-3s",
      "description": "Previous after 3 s restarts the track",
      "fn": "previousAction",
      "input": {
        "length": 3,
        "index": 1,
        "repeat": "off",
        "progressSec": 3.5
      },
      "expected": {
        "type": "restart"
      }
    },
    {
      "id": "prev-exactly-3s",
      "description": "Previous at exactly 3 s goes back (threshold is >3 s)",
      "fn": "previousAction",
      "input": {
        "length": 3,
        "index": 1,
        "repeat": "off",
        "progressSec": 3
      },
      "expected": {
        "type": "go",
        "index": 0
      }
    },
    {
      "id": "prev-middle",
      "description": "Previous early in the track goes to index-1",
      "fn": "previousAction",
      "input": {
        "length": 3,
        "index": 2,
        "repeat": "off",
        "progressSec": 1
      },
      "expected": {
        "type": "go",
        "index": 1
      }
    },
    {
      "id": "prev-first-repeat-off",
      "description": "Previous at the first item with repeat off restarts (web bug: wrapped to last)",
      "fn": "previousAction",
      "input": {
        "length": 3,
        "index": 0,
        "repeat": "off",
        "progressSec": 0
      },
      "expected": {
        "type": "restart"
      }
    },
    {
      "id": "prev-first-repeat-all",
      "description": "Previous at the first item with repeat all wraps to last",
      "fn": "previousAction",
      "input": {
        "length": 3,
        "index": 0,
        "repeat": "all",
        "progressSec": 0
      },
      "expected": {
        "type": "go",
        "index": 2
      }
    },
    {
      "id": "prev-first-repeat-one",
      "description": "Previous at the first item with repeat one restarts",
      "fn": "previousAction",
      "input": {
        "length": 3,
        "index": 0,
        "repeat": "one",
        "progressSec": 0
      },
      "expected": {
        "type": "restart"
      }
    },
    {
      "id": "prev-single-repeat-all",
      "description": "Single-item queue with repeat all restarts",
      "fn": "previousAction",
      "input": {
        "length": 1,
        "index": 0,
        "repeat": "all",
        "progressSec": 0
      },
      "expected": {
        "type": "restart"
      }
    },
    {
      "id": "playnext-first",
      "description": "First play-next goes right after current",
      "fn": "playNextInsertIndex",
      "input": {
        "currentIndex": 2,
        "pending": 0
      },
      "expected": 3
    },
    {
      "id": "playnext-fifo",
      "description": "Second play-next goes after the first (FIFO; Android bug: LIFO)",
      "fn": "playNextInsertIndex",
      "input": {
        "currentIndex": 2,
        "pending": 1
      },
      "expected": 4
    },
    {
      "id": "playnext-empty-queue",
      "description": "Play-next on an empty queue goes to 0",
      "fn": "playNextInsertIndex",
      "input": {
        "currentIndex": -1,
        "pending": 0
      },
      "expected": 0
    },
    {
      "id": "pending-advance",
      "description": "Advancing by one consumes one pending play-next",
      "fn": "pendingAfterTransition",
      "input": {
        "pending": 2,
        "oldIndex": 3,
        "newIndex": 4
      },
      "expected": 1
    },
    {
      "id": "pending-jump",
      "description": "Any jump resets the pending counter",
      "fn": "pendingAfterTransition",
      "input": {
        "pending": 2,
        "oldIndex": 3,
        "newIndex": 7
      },
      "expected": 0
    },
    {
      "id": "pending-back",
      "description": "Going back resets the pending counter",
      "fn": "pendingAfterTransition",
      "input": {
        "pending": 1,
        "oldIndex": 3,
        "newIndex": 2
      },
      "expected": 0
    },
    {
      "id": "upnext-continues-queue",
      "description": "After upNext the queue continues after the old current (web bug: restarted from 0)",
      "fn": "consumeUpNext",
      "input": {
        "queue": [
          "a",
          "b",
          "c",
          "d"
        ],
        "index": 1,
        "upNext": [
          "x",
          "y"
        ],
        "broken": []
      },
      "expected": {
        "queue": [
          "a",
          "b",
          "x",
          "c",
          "d"
        ],
        "index": 2,
        "upNext": [
          "y"
        ],
        "track": "x"
      }
    },
    {
      "id": "upnext-skip-broken",
      "description": "Broken upNext items are dropped",
      "fn": "consumeUpNext",
      "input": {
        "queue": [
          "a",
          "b"
        ],
        "index": 0,
        "upNext": [
          "x",
          "y"
        ],
        "broken": [
          "x"
        ]
      },
      "expected": {
        "queue": [
          "a",
          "y",
          "b"
        ],
        "index": 1,
        "upNext": [],
        "track": "y"
      }
    },
    {
      "id": "upnext-all-broken",
      "description": "All upNext broken \u2192 null (fall back to queue)",
      "fn": "consumeUpNext",
      "input": {
        "queue": [
          "a"
        ],
        "index": 0,
        "upNext": [
          "x"
        ],
        "broken": [
          "x"
        ]
      },
      "expected": null
    },
    {
      "id": "upnext-empty-queue",
      "description": "upNext on an empty queue",
      "fn": "consumeUpNext",
      "input": {
        "queue": [],
        "index": -1,
        "upNext": [
          "x"
        ],
        "broken": []
      },
      "expected": {
        "queue": [
          "x"
        ],
        "index": 0,
        "upNext": [],
        "track": "x"
      }
    },
    {
      "id": "move-current",
      "description": "Moving the current item follows it",
      "fn": "indexAfterMove",
      "input": {
        "from": 1,
        "to": 3,
        "current": 1
      },
      "expected": 3
    },
    {
      "id": "move-before-to-after",
      "description": "Moving an earlier item past current shifts current left",
      "fn": "indexAfterMove",
      "input": {
        "from": 0,
        "to": 2,
        "current": 1
      },
      "expected": 0
    },
    {
      "id": "move-after-to-before",
      "description": "Moving a later item before current shifts current right",
      "fn": "indexAfterMove",
      "input": {
        "from": 3,
        "to": 0,
        "current": 1
      },
      "expected": 2
    },
    {
      "id": "move-unrelated",
      "description": "Moving unrelated items keeps current",
      "fn": "indexAfterMove",
      "input": {
        "from": 3,
        "to": 4,
        "current": 1
      },
      "expected": 1
    },
    {
      "id": "remove-before",
      "description": "Removing before current shifts it left",
      "fn": "indexAfterRemove",
      "input": {
        "removed": 0,
        "current": 2,
        "length": 4
      },
      "expected": 1
    },
    {
      "id": "remove-current-last",
      "description": "Removing the current last item selects the new last",
      "fn": "indexAfterRemove",
      "input": {
        "removed": 3,
        "current": 3,
        "length": 4
      },
      "expected": 2
    },
    {
      "id": "remove-only",
      "description": "Removing the only item empties the queue",
      "fn": "indexAfterRemove",
      "input": {
        "removed": 0,
        "current": 0,
        "length": 1
      },
      "expected": -1
    },
    {
      "id": "persist-small",
      "description": "Small queues are persisted as-is",
      "fn": "persistWindow",
      "input": {
        "queue": [
          "a",
          "b",
          "c"
        ],
        "index": 2,
        "max": 50
      },
      "expected": {
        "queue": [
          "a",
          "b",
          "c"
        ],
        "index": 2
      }
    },
