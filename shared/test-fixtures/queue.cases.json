    {
      "id": "restore-ok",
      "description": "Persisted index still points at current",
      "fn": "restoreIndex",
      "input": {
        "ids": [
          "a",
          "b",
          "c"
        ],
        "index": 1,
        "currentId": "b"
      },
      "expected": 1
    },
    {
      "id": "restore-find",
      "description": "Stale index \u2192 find current by id",
      "fn": "restoreIndex",
      "input": {
        "ids": [
          "a",
          "b",
          "c"
        ],
        "index": 7,
        "currentId": "c"
      },
      "expected": 2
    },
    {
      "id": "restore-clamp",
      "description": "Current missing \u2192 clamp index",
      "fn": "restoreIndex",
      "input": {
        "ids": [
          "a",
          "b"
        ],
        "index": 7,
        "currentId": "z"
      },
      "expected": 1
    },
    {
      "id": "repeat-to-media3-off",
      "description": "off \u2192 Media3 REPEAT_MODE_OFF",
      "fn": "repeatToMedia3",
      "input": {
        "mode": "off"
      },
      "expected": 0
    },
    {
      "id": "repeat-to-media3-one",
      "description": "one \u2192 REPEAT_MODE_ONE",
      "fn": "repeatToMedia3",
      "input": {
        "mode": "one"
      },
      "expected": 1
    },
    {
      "id": "repeat-to-media3-all",
      "description": "all \u2192 REPEAT_MODE_ALL",
      "fn": "repeatToMedia3",
      "input": {
        "mode": "all"
      },
      "expected": 2
